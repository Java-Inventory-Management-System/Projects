{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "jdtls": {
      "command": ["/home/dawnbreaker/.local/bin/jdtls"],
      "initialization": {
        "settings": {
          "java": {
            "autobuild": { "enabled": false },
            "import": {
              "exclusions": ["**/node_modules/**", "**/.git/**"],
            },
          },
        },
      },
    },
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["/home/dawnbreaker/.local/bin/codegraph", "serve", "--mcp"],
      "enabled": true,
    },
  },
}
