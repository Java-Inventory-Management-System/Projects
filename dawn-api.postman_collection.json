  "item": [
    {
      "name": "1️⃣ AUTH",
      "item": [
        {
          "name": "1.1 Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "  pm.collectionVariables.set('adminToken', jsonData.data.accessToken);",
                  "  pm.collectionVariables.set('ts', Date.now());",
                  "  console.log('✅ adminToken saved');",
                  "} else {",
                  "  console.log('❌ Login Admin response:', JSON.stringify(jsonData));",
                  "  pm.expect.fail('Login Admin that bai');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.2 Create MANAGER User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.tempPassword) {",
                  "  pm.collectionVariables.set('managerUser', jsonData.data.username);",
                  "  pm.collectionVariables.set('managerPass', jsonData.data.tempPassword);",
                  "} else {",
                  "  console.log('⚠️ Khong tao duoc MANAGER user:', JSON.stringify(jsonData));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Manager User\",\n  \"email\": \"mgr{{ts}}@example.com\",\n  \"roleName\": \"MANAGER\",\n  \"status\": \"ACTIVE\"\n}" },
            "url": { "raw": "{{base_url}}/user", "host": ["{{base_url}}"], "path": ["user"] }
          }
        },
        {
          "name": "1.3 Login Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "  pm.collectionVariables.set('managerToken', jsonData.data.accessToken);",
                  "} else {",
                  "  console.log('⚠️ Khong login duoc MANAGER, managerToken se trong');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{managerUser}}\",\n  \"password\": \"{{managerPass}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
