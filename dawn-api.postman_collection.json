  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8888/api/v1" },
    { "key": "adminToken", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "brandId", "value": "" },
    { "key": "categoryId", "value": "" },
