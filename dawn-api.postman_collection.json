    {
      "name": "6️⃣ NHẬP KHO (adminToken cho GET, managerToken cho CREATE)",
      "item": [
        {
          "name": "Import Receipt - List (adminToken)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{base_url}}/import-receipt?page=0&size=10", "host": ["{{base_url}}"], "path": ["import-receipt"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] }
          }
        },
        {
          "name": "Create Import (NEED managerToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "  pm.collectionVariables.set('importReceiptId', jsonData.data.id);",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('base_url') + '/product-unit?page=0&size=1',",
                  "    method: 'GET',",
                  "    header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('adminToken') }",
                  "  }, function (err, res) {",
                  "    if (!err) {",
                  "      const body = res.json();",
                  "      if (body.data && body.data.content && body.data.content.length > 0)",
                  "        pm.collectionVariables.set('productUnitId', body.data.content[0].id);",
                  "    }",
                  "  });",
                  "} else { console.log('⚠️ Import create that bai (can managerToken)'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"receiptCode\": \"NK-{{ts}}\",\n  \"supplierId\": {{supplierId}},\n  \"note\": \"Nhap hang\",\n  \"items\": [{\n    \"productId\": {{productId}},\n    \"quantity\": 1,\n    \"unitPrice\": 25000000,\n    \"warrantyMonths\": 12,\n    \"serialNumbers\": [\"SN{{ts}}_001\"]\n  }]\n}" },
            "url": { "raw": "{{base_url}}/import-receipt", "host": ["{{base_url}}"], "path": ["import-receipt"] }
          }
        },
        {
          "name": "Approve Import (adminToken - ADMIN duoc duyet)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{base_url}}/import-receipt/{{importReceiptId}}/approve", "host": ["{{base_url}}"], "path": ["import-receipt", "{{importReceiptId}}", "approve"] }
          }
        }
      ]
    },
