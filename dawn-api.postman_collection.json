    { "key": "productId", "value": "" },
    { "key": "productImageId", "value": "" },
    { "key": "locationId", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "importReceiptId", "value": "" },
    { "key": "exportReceiptId", "value": "" },
    { "key": "stockCheckId", "value": "" },
    { "key": "productUnitId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "managerUser", "value": "" },
    { "key": "managerPass", "value": "" },
    { "key": "ts", "value": "" }
